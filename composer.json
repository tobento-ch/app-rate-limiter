{
    "name": "tobento/app-rate-limiter",
    "version": "2.0",
    "type": "library",
    "description": "App rate limiter support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "rate limiter"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-cache": "^2.0",
        "symfony/rate-limiter": "^7.3"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-user": "^2.0",
        "tobento/app-event": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\RateLimiter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\RateLimiter\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}